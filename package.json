    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
