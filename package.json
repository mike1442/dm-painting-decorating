  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app/admin app/login app/d app/api/admin app/api/auth app/api/contact app/api/mcp app/api/oauth app/api/chatgpt app/oauth app/.well-known components/admin components/documents components/ContactForm.tsx lib middleware.ts playwright.config.ts playwright.live.config.ts tests",
