# Primary website: https://www.dmpaintingdecorating.co.uk
# Business email: info@dmpaintingdecorating.co.uk

# Required for sending photo enquiries through the website
RESEND_API_KEY=
# Verified sender on your domain, e.g. enquiries@dmpaintingdecorating.co.uk
DM_CONTACT_FROM_EMAIL=
# Business WhatsApp mobile, international digits only, e.g. 447... (not the 0333 landline)
NEXT_PUBLIC_DM_WHATSAPP_NUMBER=

# D&M admin (/admin). Both values are public by design (security is Supabase Auth + RLS).
# Never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
